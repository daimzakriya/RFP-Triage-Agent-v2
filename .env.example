# Google AI Studio key (free tier, no card): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Backup provider, used automatically when Gemini is busy or out of quota (recommended).
# Free Mistral key (no card): https://console.mistral.ai/api-keys
# FALLBACK_API_KEY=
# FALLBACK_BASE_URL=https://api.mistral.ai/v1
# FALLBACK_MODEL=mistral-small-latest

# Optional
# GEMINI_MODEL=gemini-3.5-flash-lite           # v1 single-call pipeline only
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
# EXTRACT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# REASON_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_THINKING_LEVEL=low        # low | medium | high (Gemini 3 models)
# RATE_LIMIT_PER_10_MIN=12

# Offline test mode for local UI work only. Replays recorded answers for the two
# challenge sample RFPs. Never set this in production.
# RFP_FIXTURE_MODE=1
