# Google AI Studio key (free tier, no card): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Backup provider, used automatically when Gemini is busy or out of quota (recommended).
# Free Mistral key (no card): https://console.mistral.ai/api-keys
# FALLBACK_API_KEY=
# FALLBACK_BASE_URL=https://api.mistral.ai/v1
# FALLBACK_MODELS=deepseek-v4-1-flash-1017,mistral-small-latest   # tried in order; used for ONE whole-document call

# NVIDIA build.nvidia.com free endpoint (Nemotron), used after the Mistral models. Only the key is needed.
# NVIDIA_API_KEY=
# NVIDIA_MODELS=nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3-ultra-550b-a55b

# Optional extra backup provider (any OpenAI-compatible API), e.g. NVIDIA build.nvidia.com or OpenRouter:
# FALLBACK2_NAME=NVIDIA
# FALLBACK2_API_KEY=
# FALLBACK2_BASE_URL=https://integrate.api.nvidia.com/v1
# FALLBACK2_MODELS=<model id from the provider's catalog>

# Optional
# GEMINI_MODEL=gemini-3.5-flash-lite           # v1 single-call pipeline only
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
# EXTRACT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3-flash-preview
# REASON_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_THINKING_LEVEL=low        # low | medium | high (Gemini 3 models)
# RATE_LIMIT_PER_10_MIN=12

# Offline test mode for local UI work only. Replays recorded answers for the two
# challenge sample RFPs. Never set this in production.
# RFP_FIXTURE_MODE=1

# Speed: per-model time limits (ms). A busy model is skipped at once and tried last for 90 s.
# EXTRACT_ATTEMPT_MS=30000
# REASON_ATTEMPT_MS=40000
